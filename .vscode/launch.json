{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "DGE: camera-selection",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/launch.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "--config", "configs/dge_main.yaml",
                "--train", 
                "--gpu", "2",
                "trainer.max_steps=1500",
                "system.prompt_processor.prompt=Turn the man into a clown",
                "data.source=/working/style-transfer/VcEdit/gs_data/face/",
                "system.guidance.guidance_scale=12.5",
                "system.gs_source=/working/style-transfer/VcEdit/gs_data/trained_gs_models/face/point_cloud.ply",
                "system.seg_prompt=head",
                "system.mask_thres=0.6",
                "data.max_view_num=25",
                "system.camera_update_per_step=1500",
                "system.target_prompt=A clown",
                "system.loss.lambda_d=10.0",
                "data.max_edit_view_num=20",
                "data.edit_view_selection_strategy=depth",
                "system.guidance.edit_view_selection_strategy=depth",
                "system.mask_update_at_step=400",
                "name=camera-selection/w-MaskUpdate/iter1/lambda_d10.0/depth"
            ],
            // "env": {
            //     "CUDA_VISIBLE_DEVICES": "2"
            // },
            "cwd": "${workspaceFolder}",
            "python": "${command:python.interpreterPath}"
        },
