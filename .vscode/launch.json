        {
            "name": "DGE: camera-selection",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/launch.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "--config", "configs/dge_camera-selection.yaml",
                "--train", 
                "--gpu", "2",
                "trainer.max_steps=1500",

                // "system.prompt_processor.prompt=Turn the man into a clown",
