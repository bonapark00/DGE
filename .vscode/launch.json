{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DGE: camera-selection-lens",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/launch.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "--config", "configs/dge_camera-selection.yaml",
                "--train", 
                "--gpu", "0",
                "trainer.max_steps=1500",

                // --- Task Prompts & Data ---
                "system.prompt_processor.prompt=Make the pooh look like a robot",
                "system.seg_prompt=pooh",
                "data.mmr_seg_prompt=pooh",
                "system.target_prompt=robot",
                "data.lens_edit_prompt=Make the pooh look like a robot",

                // "system.prompt_processor.prompt=Make the pooh look like a panda",
                // "system.seg_prompt=pooh",
                // "data.mmr_seg_prompt=pooh",
                // "system.target_prompt=panda",
                // "data.lens_edit_prompt=Make the pooh look like a panda",


                "data.source=/data/users/jaeyeonpark/dataset/3d-ovs/covered_desk",
                "system.gs_source=/data/users/jaeyeonpark/3dgs-trained/3d-ovs/covered_desk/point_cloud/iteration_30000/point_cloud.ply",

                // --- Loss & Guidance Settings ---
                "system.guidance.guidance_scale=12.5",
                "system.mask_thres=0.6",
                "system.mask_max_ratio=0.6",
                "system.mask_min_ratio=0.01",
                "system.mask_outlier_iqr=1.5",
                "system.loss.lambda_d=0.0",
                "system.loss.lambda_dds=0.001",
                "system.dds_t_range=[0.02,0.5]",
                "system.dds_cfg_scale=7.5",
                "system.loss.lambda_ism=0.0001",
                "system.loss.use_sds=false",
                "system.guidance.use_sds_dge=false",
                "system.loss.lambda_sds=0.0",
                "system.warp_refine_color_fit_steps=100",
                "system.use_warp_refine=false",

                "system.use_gaussian_provenance=true",
                "system.gp_K=2",
                "system.gp_M_half=1",
                "system.gp_vis_eps=0.05",
                "system.gp_alpha_tau=0.4",

                "data.max_view_num=25",
                "data.max_edit_view_num=20",
                // "data.edit_view_selection_strategy=random",
                // "system.guidance.edit_view_selection_strategy=random",
                "data.edit_view_selection_strategy=lens",
                "system.guidance.edit_view_selection_strategy=lens",
                
                "data.lens_ply_path=/data/users/jaeyeonpark/3dgs-trained/3d-ovs/covered_desk/point_cloud/iteration_30000/point_cloud.ply",
                "data.lens_seg_prompt=pooh",
                "data.lens_use_ip2p_scoring=true",
                "data.lens_ip2p_steps=5",
                "data.lens_ip2p_guidance_scale=12.5",
                "data.lens_ip2p_image_guidance_scale=1.5",
                "data.lens_distance_multipliers=2.0,2.5,3.0,4.0,5.0,6.0",
                "data.lens_cone_half_angle_deg=60",
                "data.lens_lambda_leak=1.5",
                "data.lens_lambda_ent=15.0",

                // --- Update Steps & Pruning ---
                "system.camera_update_per_step=1500",
                "system.mask_update_at_step=600",
                "system.mask_update_view_num=5",
                "system.prune_floater_at_step=-1",

                "name=camera-selection/w-MaskUpdate/iter1/lambda_d0.0/lens/3d-ovs/covered_desk"
            ],
            "cwd": "${workspaceFolder}",
            "python": "${command:python.interpreterPath}"
        },

